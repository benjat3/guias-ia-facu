STYLE_SETTINGS_CSS=body.css-settings-manager { --strong-color: #D32F2F; --h2-weight: 700; --h3-color: #2E7D32; --h4-color: #F57C00; --h5-color: #C2185B; --h6-color: #546E7A; --h1-size: 1.8em; --h3-size: 1.3em; --h4-weight: 600; --h4-transform: none; --h5-weight: 700; --h6-weight: 600; --quote-color: #5D6D7E; --code-normal: #C0392B; --code-color-d: #E74C3C; --tag-background-color-l: #F2F3F4; --tag-font-color-l: #34495E; --tag-background-color-d: #34495E; --tag-font-color-d: #F2F3F4; --progress-color-1: #C0392B; --progress-color-2: #D35400; --progress-color-3: #F39C12; --progress-color-4: #27AE60; --progress-color-5: #3498DB; --h1-color: #2980B9; --h2-color: #00838F; --em-color: #8E24AA; } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-linux is-frameless is-hidden-frameless obsidian-app styled-scrollbars show-inline-title is-floating-nav auto-full-screen show-view-header hider-status hider-file-nav-header hider-instructions css-settings-manager image-alignment-default-center image-alignment-click-image-to-edit active-line fancy-highlight progress-color h2-underline is-maximized show-ribbon
