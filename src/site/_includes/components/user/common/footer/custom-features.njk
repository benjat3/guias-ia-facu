<!-- ==========================================================================
     MEJORAS INTERACTIVAS: TABLAS, PROMPTS + PERSONALIZADOR + TIKZ, CHECKLISTS 07,
     ÍNDICE (TOC) Y LIGHTBOX EXCLUSIVO PARA CAPTURAS DE PANTALLA
     Obsidian Digital Garden - Archivo de personalización de usuario seguro
     ========================================================================== -->

<!-- Modal Lightbox Exclusivo para Capturas de Pantalla (main.content img) -->
<div id="image-lightbox-modal" class="img-lightbox-modal" role="dialog" aria-modal="true" aria-label="Vista ampliada de captura de pantalla" style="display: none;">
  <div class="img-lightbox-backdrop" id="img-lightbox-backdrop"></div>
  <button type="button" class="img-lightbox-close" id="img-lightbox-close" title="Cerrar vista ampliada (Esc)">✕ Cerrar</button>
  <div class="img-lightbox-content">
    <img class="img-lightbox-img" id="img-lightbox-target" src="" alt="">
    <div class="img-lightbox-caption" id="img-lightbox-caption" style="display: none;"></div>
  </div>
</div>

<script>
(function() {
  'use strict';

  let tikzJaxInjected = false;

  function ensureTikzJaxLoaded() {
    if (tikzJaxInjected) return;
    tikzJaxInjected = true;

    if (!document.querySelector('link[href*="tikzjax.com/v1/fonts.css"]')) {
      const fontLink = document.createElement('link');
      fontLink.rel = 'stylesheet';
      fontLink.type = 'text/css';
      fontLink.href = 'https://tikzjax.com/v1/fonts.css';
      document.head.appendChild(fontLink);
    }

    if (!document.querySelector('script[src*="tikzjax.com/v1/tikzjax.js"]')) {
      const scriptEl = document.createElement('script');
      scriptEl.src = 'https://tikzjax.com/v1/tikzjax.js';
      document.head.appendChild(scriptEl);
    }
  }

  // Ejecutar inmediatamente si main.content ya está en el DOM (el footer se incluye después de main.content)
  if (document.querySelector('main.content')) {
    initAllCustomFeatures();
  } else if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllCustomFeatures);
  } else {
    initAllCustomFeatures();
  }

  function initAllCustomFeatures() {
    initFixBrokenTables();
    initSmartPrompts();
    initInteractiveChecklists();
    initPageTOC();
    initImageLightbox();
  }

  /* ==========================================================================
     0. REPARADOR AUTOMÁTICO DE TABLAS MARKDOWN (Ej. sintaxis |-:--- de Obsidian)
     ========================================================================== */
  function initFixBrokenTables() {
    const paragraphs = document.querySelectorAll('main.content p');

    paragraphs.forEach(function(p) {
      const inner = p.innerHTML.trim();
      if (inner.indexOf('|') !== 0) return;

      const lines = inner
        .split(/<br\s*\/?>|\r?\n/)
        .map(function(l) { return l.trim(); })
        .filter(Boolean);

      if (lines.length < 3) return;

      // Verificar si la segunda línea es un separador de tabla Markdown (como |-:---| o |---|)
      if (!/^\|[\s\-:|]+\|?$/.test(lines[1])) return;

      function parseCells(line) {
        const cleaned = line.replace(/^\|/, '').replace(/\|$/, '');
        return cleaned.split('|').map(function(c) { return c.trim(); });
      }

      const headers = parseCells(lines[0]);
      const bodyRows = lines.slice(2).map(parseCells);

      const wrapper = document.createElement('div');
      wrapper.className = 'table-wrapper';

      let tableHtml = '<table><thead><tr>';
      headers.forEach(function(h) {
        tableHtml += '<th style="text-align:left">' + h + '</th>';
      });
      tableHtml += '</tr></thead><tbody>';

      bodyRows.forEach(function(row) {
        if (row.length === 0 || (row.length === 1 && row[0] === '')) return;
        tableHtml += '<tr>';
        for (let i = 0; i < headers.length; i++) {
          tableHtml += '<td style="text-align:left">' + (row[i] !== undefined ? row[i] : '') + '</td>';
        }
        tableHtml += '</tr>';
      });

      tableHtml += '</tbody></table>';
      wrapper.innerHTML = tableHtml;

      p.parentNode.replaceChild(wrapper, p);
    });
  }

  /* ==========================================================================
     AUXILIAR: EXTRACCIÓN DE PLANTILLAS TIKZ PARA PREVISUALIZACIÓN VECTORIAL
     ========================================================================== */
  function extractTikzTemplates(rawText, langName) {
    const results = [];
    const fenceRegex = /(?:####\s+([^\n]+)\s*\n+)?```tikz\s*\n([\s\S]*?)```/g;
    let match;

    while ((match = fenceRegex.exec(rawText)) !== null) {
      let rawTitle = (match[1] || '').trim();
      if (!rawTitle) {
        rawTitle = 'Plantilla Gráfica TikZ #' + (results.length + 1);
      } else {
        rawTitle = rawTitle
          .replace(/`([^`]+)`/g, '$1')
          .replace(/\$\\mathrm\{([^}]+)\}\$/g, '$1')
          .replace(/\$\\Delta\$/g, 'Δ')
          .replace(/\$([^$]+)\$/g, '$1');
      }
      const code = normalizeTikzDocument(match[2]);
      if (code) {
        results.push({ title: rawTitle, code: code });
      }
    }

    if (results.length === 0 && (langName === 'TIKZ' || rawText.indexOf('\\begin{tikzpicture}') !== -1)) {
      if (rawText.indexOf('```tikz') === -1) {
        const code = normalizeTikzDocument(rawText);
        if (code) {
          results.push({ title: 'Gráfico Vectorial TikZ', code: code });
        }
      }
    }

    return results;
  }

  function normalizeTikzDocument(codeStr) {
    const trimmed = (codeStr || '').trim();
    if (trimmed.indexOf('\\begin{tikzpicture}') === -1 && trimmed.indexOf('\\begin{circuitikz}') === -1) {
      return '';
    }
    if (trimmed.indexOf('\\begin{document}') !== -1) {
      return trimmed;
    }
    return '\\begin{document}\n' + trimmed + '\n\\end{document}';
  }

  /* ==========================================================================
     1. CAJAS DE PROMPTS INTELIGENTES + PERSONALIZADOR RÁPIDO (MEJORA A) +
        VISTA PREVIA DE PLANTILLAS TIKZ (MEJORA 4)
     ========================================================================== */
  function initSmartPrompts() {
    const codeBlocks = document.querySelectorAll('main.content pre');

    codeBlocks.forEach(function(pre) {
      if (pre.classList.contains('mermaid') || pre.closest('.mermaid') || pre.closest('.block-language-mermaid')) {
        return;
      }
      if (pre.closest('.prompt-box-wrapper')) {
        return;
      }

      const codeEl = pre.querySelector('code') || pre;

      // Reparar wikilinks de ejemplo como ![[imagen.png|450]] que Eleventy convierte en <a href="/404">450</a>
      codeEl.querySelectorAll('a.internal-link.is-unresolved').forEach(function(brokenLink) {
        if (brokenLink.textContent.trim() === '450') {
          const prev = brokenLink.previousSibling;
          if (prev && prev.nodeType === 3 && /!$/.test(prev.nodeValue)) {
            prev.nodeValue = prev.nodeValue.replace(/!$/, '');
          }
          brokenLink.replaceWith(document.createTextNode('![[imagen.png|450]]'));
        }
      });

      const rawText = codeEl.innerText.replace(/\r\n/g, '\n');
      const lines = rawText.split('\n');
      if (lines.length > 1 && lines[lines.length - 1].trim() === '') {
        lines.pop();
      }
      const lineCount = lines.length;

      let langName = 'PROMPT';
      const classAttr = (codeEl.className || '') + ' ' + (pre.className || '');
      const matchLang = classAttr.match(/language-([a-zA-Z0-9_\-]+)/);
      if (matchLang && matchLang[1] && matchLang[1] !== 'none') {
        langName = matchLang[1].toUpperCase();
      }

      // Detectar variables personalizables (Mejora A)
      const hasTemaVar = rawText.indexOf('[TEMA A APRENDER]') !== -1;
      const hasDemoVar = rawText.indexOf('¿Incluir demostraciones / deducciones paso a paso? [SI / NO]: NO') !== -1;
      const hasUnidadVar = rawText.indexOf('Unidad o tema a procesar: DESDE EL PRINCIPIO') !== -1;

      let customControlsHtml = '';
      if (hasTemaVar) {
        customControlsHtml += `
          <label class="prompt-customizer-control" title="Si escribís tu materia o tema acá, al copiar se reemplaza automáticamente [TEMA A APRENDER]">
            <span class="prompt-customizer-label">✏️ Tema:</span>
            <input type="text" class="prompt-customizer-input js-custom-tema" placeholder="Escribí tu materia o tema...">
          </label>
        `;
      }
      if (hasUnidadVar) {
        customControlsHtml += `
          <label class="prompt-customizer-control" title="Si escribís una unidad puntual, al copiar reemplaza DESDE EL PRINCIPIO">
            <span class="prompt-customizer-label">📂 Unidad:</span>
            <input type="text" class="prompt-customizer-input js-custom-unidad" placeholder="Unidad (defecto: DESDE EL PRINCIPIO)">
          </label>
        `;
      }
      if (hasDemoVar) {
        customControlsHtml += `
          <button type="button" class="prompt-customizer-toggle js-custom-demo" data-value="NO" title="Elegí si querés incluir demostraciones paso a paso al copiar el prompt">
            <span>Demostraciones:</span>
            <span class="demo-opt is-active" data-opt="NO">[NO]</span>
            <span>/</span>
            <span class="demo-opt" data-opt="SI">[SÍ]</span>
          </button>
        `;
      }

      const wrapper = document.createElement('div');
      wrapper.className = 'prompt-box-wrapper';

      const header = document.createElement('div');
      header.className = 'prompt-box-header';
      header.innerHTML = `
        <div class="prompt-box-meta-info">
          <span class="prompt-box-badge">💬 ${langName}</span>
          <span class="prompt-box-lines-count">${lineCount} líneas</span>
        </div>
        <div class="prompt-header-actions">
          ${customControlsHtml}
          <button type="button" class="prompt-copy-btn" title="Copiar prompt al portapapeles">
            <span class="copy-icon" aria-hidden="true">📋</span>
            <span class="copy-text">Copiar Prompt</span>
          </button>
        </div>
      `;

      const codeContainer = document.createElement('div');
      const isLong = lineCount > 15;
      codeContainer.className = 'prompt-code-container' + (isLong ? ' is-collapsed' : '');

      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(codeContainer);
      codeContainer.appendChild(pre);

      // Eventos del selector rápido de Demostraciones [NO] / [SÍ]
      const demoToggleBtn = header.querySelector('.js-custom-demo');
      if (demoToggleBtn) {
        demoToggleBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          const current = demoToggleBtn.getAttribute('data-value') === 'SI' ? 'SI' : 'NO';
          const next = current === 'NO' ? 'SI' : 'NO';
          demoToggleBtn.setAttribute('data-value', next);
          demoToggleBtn.querySelectorAll('.demo-opt').forEach(function(opt) {
            opt.classList.toggle('is-active', opt.getAttribute('data-opt') === next);
          });
        });
      }

      if (isLong) {
        const expandBar = document.createElement('div');
        expandBar.className = 'prompt-expand-bar';
        expandBar.innerHTML = `
          <button type="button" class="prompt-expand-btn">
            <span class="expand-icon" aria-hidden="true">🔽</span>
            <span class="expand-text">Expandir prompt completo (${lineCount} líneas)</span>
          </button>
        `;
        wrapper.appendChild(expandBar);

        const expandBtn = expandBar.querySelector('.prompt-expand-btn');
        expandBtn.addEventListener('click', function() {
          const currentlyCollapsed = codeContainer.classList.contains('is-collapsed');
          if (currentlyCollapsed) {
            codeContainer.classList.remove('is-collapsed');
            codeContainer.classList.add('is-expanded');
            expandBtn.innerHTML = `
              <span class="expand-icon" aria-hidden="true">🔼</span>
              <span class="expand-text">Contraer prompt</span>
            `;
          } else {
            codeContainer.classList.add('is-collapsed');
            codeContainer.classList.remove('is-expanded');
            expandBtn.innerHTML = `
              <span class="expand-icon" aria-hidden="true">🔽</span>
              <span class="expand-text">Expandir prompt completo (${lineCount} líneas)</span>
            `;
            const rect = wrapper.getBoundingClientRect();
            if (rect.top < 60) {
              wrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        });
      }

      // Vista previa interactiva de plantillas TikZ (Mejora 4)
      const tikzTemplates = extractTikzTemplates(rawText, langName);
      if (tikzTemplates.length > 0) {
        ensureTikzJaxLoaded();

        const previewSection = document.createElement('div');
        previewSection.className = 'tikz-preview-section';

        const countLabel = tikzTemplates.length === 1
          ? '1 gráfico vectorial'
          : tikzTemplates.length + ' plantillas vectoriales';

        previewSection.innerHTML = `
          <button type="button" class="tikz-preview-toggle-btn" aria-expanded="false">
            <span class="tikz-preview-title-wrap">
              <span>📐 Vista Previa de las Plantillas Gráficas TikZ Renderizadas</span>
              <span class="tikz-preview-badge">${countLabel}</span>
            </span>
            <span class="tikz-preview-Action">🔽 Mostrar gráficos en vivo</span>
          </button>
          <div class="tikz-preview-body">
            <p class="tikz-preview-intro">
              Gráficos compilados en vivo en el navegador con <strong>TikZJax</strong> a partir del código LaTeX/TikZ incluido en el prompt (circuitos equivalentes, curvas Par-Velocidad, diagramas fasoriales, sistemas 1-GDL, lazos de control y ciclos termodinámicos Rankine):
            </p>
            <div class="tikz-preview-grid"></div>
          </div>
        `;

        const gridEl = previewSection.querySelector('.tikz-preview-grid');
        tikzTemplates.forEach(function(tpl, idx) {
          const card = document.createElement('div');
          card.className = 'tikz-preview-card';

          const cardHeader = document.createElement('div');
          cardHeader.className = 'tikz-preview-card-header';
          cardHeader.innerHTML = `
            <span>${tpl.title}</span>
            <span class="prompt-box-lines-count">SVG Vectorial #${idx + 1}</span>
          `;

          const stage = document.createElement('div');
          stage.className = 'tikz-render-stage';

          const loadingHint = document.createElement('div');
          loadingHint.className = 'tikz-loading-hint';
          loadingHint.textContent = '⏳ Renderizando gráfico vectorial TikZ...';

          const tikzScript = document.createElement('script');
          tikzScript.type = 'text/tikz';
          tikzScript.textContent = tpl.code;

          stage.appendChild(loadingHint);
          stage.appendChild(tikzScript);
          card.appendChild(cardHeader);
          card.appendChild(stage);
          gridEl.appendChild(card);
        });

        const togglePreviewBtn = previewSection.querySelector('.tikz-preview-toggle-btn');
        const previewBody = previewSection.querySelector('.tikz-preview-body');
        const actionLabel = previewSection.querySelector('.tikz-preview-Action');

        togglePreviewBtn.addEventListener('click', function() {
          const isOpen = previewBody.classList.toggle('is-open');
          togglePreviewBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          actionLabel.textContent = isOpen ? '🔼 Ocultar gráficos' : '🔽 Mostrar gráficos en vivo';
        });

        wrapper.appendChild(previewSection);
      }

      const copyBtn = header.querySelector('.prompt-copy-btn');
      copyBtn.addEventListener('click', function() {
        let textToCopy = rawText;

        const temaInput = header.querySelector('.js-custom-tema');
        if (temaInput && temaInput.value.trim() !== '') {
          textToCopy = textToCopy.split('[TEMA A APRENDER]').join(temaInput.value.trim());
        }

        const unidadInput = header.querySelector('.js-custom-unidad');
        if (unidadInput && unidadInput.value.trim() !== '') {
          textToCopy = textToCopy.replace(
            'Unidad o tema a procesar: DESDE EL PRINCIPIO',
            'Unidad o tema a procesar: ' + unidadInput.value.trim()
          );
        }

        if (demoToggleBtn) {
          const demoVal = demoToggleBtn.getAttribute('data-value') === 'SI' ? 'SI' : 'NO';
          textToCopy = textToCopy.replace(
            '¿Incluir demostraciones / deducciones paso a paso? [SI / NO]: NO',
            '¿Incluir demostraciones / deducciones paso a paso? [SI / NO]: ' + demoVal
          );
        }

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(textToCopy).then(showSuccess, fallbackCopy);
        } else {
          fallbackCopy();
        }

        function fallbackCopy() {
          try {
            const ta = document.createElement('textarea');
            ta.value = textToCopy;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            showSuccess();
          } catch (e) {
            console.error('Error copiando:', e);
          }
        }

        function showSuccess() {
          copyBtn.classList.add('is-copied');
          copyBtn.innerHTML = `
            <span class="copy-icon" aria-hidden="true">✅</span>
            <span class="copy-text">¡Copiado!</span>
          `;
          setTimeout(function() {
            copyBtn.classList.remove('is-copied');
            copyBtn.innerHTML = `
              <span class="copy-icon" aria-hidden="true">📋</span>
              <span class="copy-text">Copiar Prompt</span>
            `;
          }, 2400);
        }
      });
    });
  }

  /* ==========================================================================
     2. CHECKLISTS INTERACTIVAS EN LAS GUÍAS 07 + DIAGNÓSTICO EN VIVO Y FILTRO
     ========================================================================== */
  function initInteractiveChecklists() {
    const mainContent = document.querySelector('main.content');
    if (!mainContent) return;

    const containsBallot = mainContent.textContent.indexOf('☐') !== -1;
    const pathAndTitle = window.location.pathname + ' ' + document.title;
    const is07Path = /07[\.\-_][1-4]/.test(pathAndTitle);

    if (!containsBallot && !is07Path) {
      return;
    }

    let guideId = '07.1';
    if (/07[\.\-_]2/.test(pathAndTitle)) {
      guideId = '07.2';
    } else if (/07[\.\-_]3/.test(pathAndTitle)) {
      guideId = '07.3';
    } else if (/07[\.\-_]4/.test(pathAndTitle)) {
      guideId = '07.4';
    }

    function getDiagnosisForGuide(guide, pendingCount) {
      if (guide === '07.2') {
        if (pendingCount <= 5) return { level: 'good', text: '🟢 Entrenamiento práctico excelente' };
        if (pendingCount <= 13) return { level: 'warn', text: '🟡 Margen claro de mejora (priorizá los ★ CLAVE)' };
        return { level: 'danger', text: '🔴 Cuidado: estás estudiando práctica como si fuera lectura' };
      }
      if (guide === '07.3') {
        if (pendingCount <= 4) return { level: 'good', text: '🟢 Estudio teórico de alto rigor' };
        if (pendingCount <= 10) return { level: 'warn', text: '🟡 Puntos flojos bajo presión (enfocate en los ★ CLAVE)' };
        return { level: 'danger', text: '🔴 Trampa de releer para reconocer en vez de producir' };
      }
      if (guide === '07.4') {
        if (pendingCount <= 5) return { level: 'good', text: '🟢 Práctica docente alineada con la evidencia' };
        if (pendingCount <= 14) return { level: 'warn', text: '🟡 Oportunidades de alto impacto (probá 1 o 2 ★ CLAVE)' };
        return { level: 'danger', text: '🔴 Enseñanza centrada en transmitir más que en práctica activa' };
      }
      // 07.1 por defecto
      if (pendingCount <= 5) return { level: 'good', text: '🟢 Sistema de estudio muy sólido' };
      if (pendingCount <= 12) return { level: 'warn', text: '🟡 Hábitos clave por ajustar (empezá por 1 o 2 ★ CLAVE)' };
      return { level: 'danger', text: '🔴 Peligro de ilusión de competencia (exceso de estudio pasivo)' };
    }

    const pageSlug = window.location.pathname.replace(/\/$/, '').split('/').pop() || 'guia07';
    const storageKey = 'ia_facu_checklist_' + pageSlug;

    let savedData = {};
    try {
      savedData = JSON.parse(localStorage.getItem(storageKey) || '{}');
    } catch(err) {
      savedData = {};
    }

    const allLis = Array.from(mainContent.querySelectorAll('li'));
    const checklistItems = allLis.filter(function(li) {
      return li.textContent.indexOf('☐') !== -1;
    });

    if (checklistItems.length === 0) return;

    document.body.classList.add('has-checklist-bar');

    checklistItems.forEach(function(li, idx) {
      const isStarred = li.textContent.indexOf('★') !== -1;
      const isChecked = !!savedData[idx];

      li.classList.add('interactive-checklist-item');
      if (isStarred) {
        li.classList.add('checklist-item-starred');
      }
      if (isChecked) {
        li.classList.add('is-completed');
      }

      const starBadgeHtml = isStarred
        ? '<span class="checklist-star-badge" title="Hábito clave de alto impacto">★ CLAVE</span>'
        : '';

      const controlHtml = `
        <label class="checklist-item-control" title="${isChecked ? 'Marcar como pendiente' : 'Marcar como completado'}">
          <input type="checkbox" class="chk-input-native" data-idx="${idx}" ${isChecked ? 'checked' : ''}>
          <span class="checklist-custom-box" aria-hidden="true">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </span>
        </label>${starBadgeHtml}
      `;

      li.innerHTML = li.innerHTML.replace(/☐\s*(★)?\s*/, controlHtml + ' <span class="checklist-item-text">') + '</span>';

      const input = li.querySelector('.chk-input-native');
      input.addEventListener('change', function() {
        const checked = input.checked;
        savedData[idx] = checked;
        try {
          localStorage.setItem(storageKey, JSON.stringify(savedData));
        } catch(e) {}

        if (checked) {
          li.classList.add('is-completed');
        } else {
          li.classList.remove('is-completed');
        }

        updateStats();
      });

      li.addEventListener('click', function(e) {
        if (e.target.closest('a') || e.target.closest('button') || e.target.closest('input') || e.target.closest('label')) {
          return;
        }
        input.checked = !input.checked;
        input.dispatchEvent(new Event('change'));
      });
    });

    const bar = document.createElement('div');
    bar.className = 'checklist-floating-bar';
    bar.id = 'checklist-floating-bar';
    bar.innerHTML = `
      <div class="checklist-bar-header">
        <div class="checklist-bar-stats">
          <span class="stat-chip-done">✅ <strong id="chk-count-done">0</strong> marcados</span>
          <span class="stat-chip-pending">⏳ <strong id="chk-count-pending">0</strong> restantes</span>
        </div>
        <div class="checklist-bar-right">
          <div class="checklist-bar-percent" id="chk-percent">0%</div>
          <button type="button" class="checklist-minimize-btn" id="chk-btn-minimize" title="Minimizar / Expandir barra">🔽</button>
        </div>
      </div>
      <div class="checklist-progress-track">
        <div class="checklist-progress-fill" id="chk-fill"></div>
      </div>
      <div class="checklist-bar-diagnosis" id="chk-diagnosis" data-level="danger"></div>
      <div class="checklist-bar-actions">
        <button type="button" class="checklist-filter-btn" id="chk-btn-filter" title="Ocultar temporalmente los ítems ya marcados para enfocarte en los pendientes">👁️ Ver solo pendientes</button>
        <button type="button" class="checklist-reset-btn" id="chk-btn-reset">↺ Reiniciar progreso</button>
      </div>
    `;
    document.body.appendChild(bar);

    function updateStats() {
      const total = checklistItems.length;
      let completed = 0;
      for (let i = 0; i < total; i++) {
        if (savedData[i]) completed++;
      }
      const pending = total - completed;
      const pct = total > 0 ? Math.round((completed / total) * 100) : 0;

      const doneEl = document.getElementById('chk-count-done');
      const pendingEl = document.getElementById('chk-count-pending');
      const pctEl = document.getElementById('chk-percent');
      const fillEl = document.getElementById('chk-fill');
      const diagEl = document.getElementById('chk-diagnosis');

      if (doneEl) doneEl.textContent = completed;
      if (pendingEl) pendingEl.textContent = pending;
      if (pctEl) pctEl.textContent = pct + '%';
      if (fillEl) fillEl.style.width = pct + '%';

      if (diagEl) {
        const diag = getDiagnosisForGuide(guideId, pending);
        diagEl.setAttribute('data-level', diag.level);
        diagEl.textContent = diag.text;
      }
    }

    const filterBtn = document.getElementById('chk-btn-filter');
    if (filterBtn) {
      filterBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        const active = document.body.classList.toggle('checklist-filter-pending');
        filterBtn.classList.toggle('is-active', active);
        filterBtn.textContent = active ? '👁️ Mostrar todos' : '👁️ Ver solo pendientes';
      });
    }

    const minBtn = document.getElementById('chk-btn-minimize');
    if (minBtn) {
      minBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        const isMin = bar.classList.toggle('is-minimized');
        document.body.classList.toggle('checklist-bar-minimized', isMin);
        minBtn.textContent = isMin ? '🔼' : '🔽';
      });
    }

    const resetBtn = document.getElementById('chk-btn-reset');
    if (resetBtn) {
      resetBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (confirm('¿Querés reiniciar las casillas de esta guía y volver a empezar?')) {
          savedData = {};
          try {
            localStorage.removeItem(storageKey);
          } catch(e) {}

          const inputs = mainContent.querySelectorAll('.chk-input-native');
          inputs.forEach(function(inp) {
            inp.checked = false;
            const li = inp.closest('.interactive-checklist-item');
            if (li) li.classList.remove('is-completed');
          });

          document.body.classList.remove('checklist-filter-pending');
          if (filterBtn) {
            filterBtn.classList.remove('is-active');
            filterBtn.textContent = '👁️ Ver solo pendientes';
          }

          updateStats();
        }
      });
    }

    updateStats();
  }

  /* ==========================================================================
     3. ÍNDICE DE LA PÁGINA (CUADRO SUPERIOR + BOTÓN Y PANEL FLOTANTE CON SCROLLSPY)
     ========================================================================== */
  function initPageTOC() {
    const mainContent = document.querySelector('main.content');
    if (!mainContent) return;

    const rawHeadings = Array.from(mainContent.querySelectorAll('h2, h3')).filter(function(h) {
      return !h.closest('.callout') && !h.closest('.prompt-box-wrapper');
    });

    if (rawHeadings.length < 2) return;

    const tocItems = rawHeadings.map(function(h, idx) {
      if (!h.id) {
        const slug = (h.textContent || 'seccion')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
        h.id = (slug || 'seccion') + '-' + idx;
      }
      return {
        id: h.id,
        text: h.textContent.trim(),
        level: h.tagName.toLowerCase() === 'h3' ? 3 : 2,
        el: h
      };
    });

    function scrollToHeading(targetId) {
      const targetEl = document.getElementById(targetId);
      if (!targetEl) return;
      targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      targetEl.classList.remove('toc-jumped-highlight');
      void targetEl.offsetWidth;
      targetEl.classList.add('toc-jumped-highlight');
      if (history.replaceState) {
        history.replaceState(null, '', '#' + targetId);
      }
    }

    const tocCard = document.createElement('nav');
    tocCard.className = 'page-toc-card';
    tocCard.setAttribute('aria-label', 'Índice de contenidos');

    let inlineListHtml = '';
    tocItems.forEach(function(item) {
      const bullet = item.level === 2 ? '▸' : '↳';
      inlineListHtml += `
        <li class="page-toc-item toc-level-${item.level}">
          <a href="#${item.id}" class="page-toc-link" data-target="${item.id}">
            <span class="toc-bullet" aria-hidden="true">${bullet}</span>
            <span>${item.text}</span>
          </a>
        </li>
      `;
    });

    tocCard.innerHTML = `
      <div class="page-toc-header" id="page-toc-header-toggle">
        <div class="page-toc-title">
          <span aria-hidden="true">📑</span>
          <span>Índice de la página</span>
          <span class="page-toc-count">${tocItems.length} secciones</span>
        </div>
        <button type="button" class="page-toc-toggle-btn" id="page-toc-toggle-btn">🔼 Ocultar</button>
      </div>
      <div class="page-toc-body" id="page-toc-body">
        <ul class="page-toc-list">
          ${inlineListHtml}
        </ul>
      </div>
    `;

    const firstH2 = rawHeadings[0];
    if (firstH2 && firstH2.parentNode) {
      firstH2.parentNode.insertBefore(tocCard, firstH2);
    }

    const headerToggle = tocCard.querySelector('#page-toc-header-toggle');
    const toggleBtn = tocCard.querySelector('#page-toc-toggle-btn');
    const tocBody = tocCard.querySelector('#page-toc-body');

    headerToggle.addEventListener('click', function() {
      const collapsed = tocBody.classList.toggle('is-collapsed');
      toggleBtn.textContent = collapsed ? '🔽 Mostrar índice' : '🔼 Ocultar';
    });

    tocCard.querySelectorAll('.page-toc-link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        scrollToHeading(link.getAttribute('data-target'));
      });
    });

    const floatingWidget = document.createElement('div');
    floatingWidget.className = 'floating-toc-widget';

    let floatingLinksHtml = '';
    tocItems.forEach(function(item) {
      floatingLinksHtml += `
        <a href="#${item.id}" class="floating-toc-entry level-${item.level}" data-target="${item.id}">
          ${item.level === 3 ? '↳ ' : ''}${item.text}
        </a>
      `;
    });

    floatingWidget.innerHTML = `
      <div class="floating-toc-popover" id="floating-toc-popover" role="dialog" aria-label="Índice rápido">
        <div class="floating-toc-popover-header">
          <span>📑 Saltar a sección</span>
          <button type="button" class="floating-toc-close" id="floating-toc-close" title="Cerrar índice">✕</button>
        </div>
        <div class="floating-toc-popover-list" id="floating-toc-list">
          ${floatingLinksHtml}
        </div>
      </div>
      <div class="floating-toc-buttons">
        <button type="button" class="floating-top-trigger" id="floating-top-btn" title="Subir al inicio de la página">⬆️</button>
        <button type="button" class="floating-toc-trigger" id="floating-toc-btn" title="Abrir índice de secciones">
          <span aria-hidden="true">📑</span>
          <span>Índice</span>
        </button>
      </div>
    `;

    document.body.appendChild(floatingWidget);

    const popover = document.getElementById('floating-toc-popover');
    const tocBtn = document.getElementById('floating-toc-btn');
    const closeTocBtn = document.getElementById('floating-toc-close');
    const topBtn = document.getElementById('floating-top-btn');
    const floatEntries = Array.from(floatingWidget.querySelectorAll('.floating-toc-entry'));

    function togglePopover(forceState) {
      const open = typeof forceState === 'boolean' ? forceState : !popover.classList.contains('is-open');
      popover.classList.toggle('is-open', open);
      tocBtn.classList.toggle('is-active', open);
    }

    tocBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      togglePopover();
    });

    closeTocBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      togglePopover(false);
    });

    topBtn.addEventListener('click', function() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    floatEntries.forEach(function(entry) {
      entry.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = entry.getAttribute('data-target');
        scrollToHeading(targetId);
        if (window.innerWidth < 900) {
          togglePopover(false);
        }
      });
    });

    document.addEventListener('click', function(e) {
      if (popover.classList.contains('is-open') && !floatingWidget.contains(e.target)) {
        togglePopover(false);
      }
    });

    function onScrollSpy() {
      const scrollY = window.scrollY || document.documentElement.scrollTop;
      topBtn.classList.toggle('is-visible', scrollY > 350);

      let currentId = tocItems[0].id;
      for (let i = 0; i < tocItems.length; i++) {
        const rect = tocItems[i].el.getBoundingClientRect();
        if (rect.top <= 130) {
          currentId = tocItems[i].id;
        } else {
          break;
        }
      }

      floatEntries.forEach(function(entry) {
        const active = entry.getAttribute('data-target') === currentId;
        entry.classList.toggle('is-current', active);
      });
    }

    window.addEventListener('scroll', onScrollSpy, { passive: true });
    onScrollSpy();
  }

  /* ==========================================================================
     4. MEJORA C: LIGHTBOX EXCLUSIVO PARA IMÁGENES / CAPTURAS (main.content img)
        (Prohibido en etiquetas <svg> o diagramas Mermaid)
     ========================================================================== */
  function initImageLightbox() {
    const modal = document.getElementById('image-lightbox-modal');
    if (!modal) return;

    const backdrop = document.getElementById('img-lightbox-backdrop');
    const closeBtn = document.getElementById('img-lightbox-close');
    const targetImg = document.getElementById('img-lightbox-target');
    const captionEl = document.getElementById('img-lightbox-caption');

    function openLightbox(src, alt, captionText) {
      targetImg.src = src;
      targetImg.alt = alt || '';
      if (captionText) {
        captionEl.textContent = captionText;
        captionEl.style.display = 'block';
      } else {
        captionEl.textContent = '';
        captionEl.style.display = 'none';
      }
      modal.style.display = 'flex';
      void modal.offsetWidth;
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      modal.classList.remove('is-open');
      setTimeout(function() {
        modal.style.display = 'none';
        targetImg.src = '';
        document.body.style.overflow = '';
      }, 220);
    }

    backdrop.addEventListener('click', closeLightbox);
    closeBtn.addEventListener('click', closeLightbox);
    targetImg.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', function(e) {
      if (modal.classList.contains('is-open') && e.key === 'Escape') {
        closeLightbox();
      }
    });

    const images = document.querySelectorAll('main.content img');
    images.forEach(function(img) {
      if (img.tagName.toLowerCase() !== 'img') return;
      if (img.closest('.mermaid') || img.closest('.block-language-mermaid') || img.closest('.tikz-preview-section')) {
        return;
      }

      img.classList.add('zoomable-screenshot');
      if (!img.title) {
        img.title = 'Clic para ampliar captura de pantalla';
      }

      img.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        let caption = '';
        const callout = img.closest('.callout');
        if (callout) {
          const titleInner = callout.querySelector('.callout-title-inner');
          if (titleInner) {
            caption = titleInner.textContent.trim();
          }
        }
        if (!caption && img.alt && !/^pasted image/i.test(img.alt.trim())) {
          caption = img.alt.trim();
        }

        openLightbox(img.src, img.alt, caption);
      });
    });
  }

})();
</script>
